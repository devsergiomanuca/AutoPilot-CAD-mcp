<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugin que roda DENTRO do AutoCAD 2025 (instalado como bundle pelo setup.ps1). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>AcadBridge.Plugin</AssemblyName>
    <RootNamespace>AcadBridge.Plugin</RootNamespace>
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- API .NET do AutoCAD 2025 pelos pacotes oficiais da Autodesk (série 25.0 = AutoCAD 2025, net8.0).
         Compila sem o AutoCAD instalado (CI do GitHub). ExcludeAssets=runtime: as DLLs NÃO vão para
         bin nem para o bundle; em execução valem as da instalação do AutoCAD.
         AutoCAD.NET 25.0.1 (não 25.0.0): o 25.0.0 depende de um Core "25.0.0-V058" que não foi publicado.
         Não suba para 25.0.2: ele foi republicado mirando net10.0. -->
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
